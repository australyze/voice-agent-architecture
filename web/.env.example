# Public browser values only.
# NEVER put inbound write secrets, operator write secrets, private provider keys,
# hosted persistence admin keys, or database URLs here.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
VITE_PUBLIC_API_BASE_URL=
# Do not bake the demo read token into the bundle for public interviews.
# Interviewers enter the passcode in the UI (sent as x-demo-public-token).
